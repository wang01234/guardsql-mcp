# -----------------------------------------------------------------------------
# GuardSQL MCP - example environment file
# Copy to `.env` (or export these variables) before running the server.
# `npm run dev` loads `.env` automatically via dotenv.
# -----------------------------------------------------------------------------

# PostgreSQL connection string used by the app.
# With docker compose the host is "postgres"; when running locally use localhost.
DATABASE_URL=postgresql://guardsql:guardsql@localhost:5432/guardsql

# Per-token bearer credentials. Each token maps to a scope in config/guardsql.yaml.
#   DEMO_READONLY_TOKEN -> read-only scope over the e-commerce tables (max 100 rows)
#   DEMO_OPS_TOKEN      -> read + propose-write scope over orders/order_items/payments
#   ADMIN_TOKEN         -> full scope (*) and access to the approval HTTP route
# Change these to long random strings in any real deployment.
DEMO_READONLY_TOKEN=readonly-demo-token-change-me
DEMO_OPS_TOKEN=ops-demo-token-change-me
ADMIN_TOKEN=admin-demo-token-change-me
